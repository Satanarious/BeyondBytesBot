# BBbot configuration
# Get this token from @BotFather after creating your bot (/newbot).
BOT_TOKEN=

# Optional: how often (in seconds) the bot checks RSS feeds. Default 300.
# RSS_POLL_SECONDS=300

# Gemini API key for the daily digest summaries — get one free at
# https://aistudio.google.com/apikey  (without it, digests fall back to
# posting plain links)
GEMINI_API_KEY=

# Optional: Gemini model override. Default is gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
