# BBbot configuration
# Get this token from @BotFather after creating your bot (/newbot).
BOT_TOKEN=

# Optional: how often (in seconds) the bot checks RSS feeds. Default 300.
# RSS_POLL_SECONDS=300

# Gemini API key for the daily digest summaries — get one free at
# https://aistudio.google.com/apikey  (without it, digests fall back to
# posting plain links)
GEMINI_API_KEY=

# Optional: Gemini model override. Default is gemini-3.1-pro-preview (the
# successor of the retired gemini-2.5-pro).
# GEMINI_MODEL=gemini-3.1-pro-preview

# Seconds to wait between posting the digest for one topic and the next
# (default 90; keeps bucket-sized breaks that respect Gemini's rate limits).
# DIGEST_GAP_SECONDS=90

# Lock the bot to one group only (the Beyond Bytes supergroup). Get the ID by
# running /list in that group while unlocked, or let the bot auto-lock once it
# has data for a single group. e.g. BB_GROUP_ID=-1001234567890
# BB_GROUP_ID=
